---
const { lang = "es" } = Astro.props;
const en = lang === "en";
const layers = [
  {
    label: "Backend",
    name: "Java / Spring Boot",
    icon: "M8 7 3 12l5 5m8-10 5 5-5 5m-3-13-2 16",
  },
  {
    label: "Interfaces",
    name: "React / Next.js",
    icon: "M3 8h18M8 8v13M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z",
  },
  {
    label: en ? "Data" : "Datos",
    name: "PostgreSQL",
    icon: "M20 6c0 2-3.6 3-8 3S4 8 4 6s3.6-3 8-3 8 1 8 3Zm0 0v12c0 2-3.6 3-8 3s-8-1-8-3V6m0 6c0 2 3.6 3 8 3s8-1 8-3",
  },
];
---

<aside
  class="pf-stack"
  aria-label={en ? "Core technology stack" : "Tecnologías principales"}
>
  <div class="pf-stack-intro">
    <span class="pf-stack-label">
      {en ? "APPLIED TECHNOLOGY" : "TECNOLOGÍA APLICADA"}
    </span>
    <strong>
      {en ? "From interface to data." : "De la interfaz a los datos."}
    </strong>
  </div>
  <ul class="pf-stack-layers">
    {layers.map((layer) => (
      <li>
        <span class="pf-stack-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={layer.icon} />
          </svg>
        </span>
        <div>
          <span class="pf-stack-role">{layer.label}</span>
          <strong>{layer.name}</strong>
        </div>
      </li>
    ))}
  </ul>
</aside>
