---
import ProjectMedia from './ProjectMedia.astro';
import ProjectSupport from './ProjectSupport.astro';
import { projectMedia } from '../data/projectMedia.js';
const { project, lang = 'es' } = Astro.props;
const en = lang === 'en';
const t = (es, english) => en ? english : es;
const copy = project[lang];
const root = en ? '/en' : '';
const flagship = project.slug === 'chiletedevpath-web';
const media = projectMedia[project.slug];
---
<article class="pf-shell pf-detail">
  <a class="pf-back" href={`${root}/`}>← {t('Volver al portafolio', 'Back to portfolio')}</a>
  <header class:list={['pf-case-hero', `pf-${project.accent}`]}>
    <div>
      <span class="pf-kicker">{flagship ? t('MI PROYECTO INSIGNIA', 'MY FLAGSHIP PROJECT') : t('SISTEMA APLICADO', 'APPLIED SYSTEM')} · {copy.category}</span>
      <h1>{project.name}</h1><p>{copy.summary}</p><span class="pf-status">{copy.status}</span>
      <div class="pf-actions"><a class="pf-button" href={project.url} target="_blank" rel="noopener noreferrer">{flagship ? t('Explorar la plataforma', 'Explore the platform') : t('Abrir aplicación', 'Open application')} ↗</a>{project.repository && <a class="pf-button pf-secondary" href={project.repository} target="_blank" rel="noopener noreferrer">{t('Repositorio', 'Repository')} ↗</a>}<a class="pf-button pf-secondary" href={`${root}/#contacto`}>{t('Conversar sobre el proyecto', 'Discuss the project')}</a></div>
      <small class="pf-access-note">{copy.access}</small>
    </div>
    <img src={project.mark} width="170" height="170" alt={t(`Identidad de ${project.name}`, `${project.name} identity`)} />
  </header>
  <ul class="pf-tags pf-case-tags" aria-label={t('Tecnologías', 'Technologies')}>{project.stack.map(tech => <li>{tech}</li>)}</ul>
  <nav class="pf-case-nav" aria-label={t('Contenido del caso', 'Case contents')}>
    <a href="#problema">{t('Problema y aporte', 'Problem and role')}</a><a href="#demostracion">{t('Álbum del proyecto', 'Project album')}</a><a href="#funciones">{t('Solución', 'Solution')}</a><a href="#decisiones">{t('Decisiones técnicas', 'Technical decisions')}</a><a href="#resultado">{t('Resultado', 'Outcome')}</a><a href="#evidencia">{t('Sustento', 'Supporting evidence')}</a>
  </nav>
  <section id="problema" class="pf-section pf-two-columns">
    <div><span class="pf-kicker">01 / {t('CONTEXTO', 'CONTEXT')}</span><h2>{t('El problema', 'The problem')}</h2><p>{copy.problem}</p></div>
    <aside class="pf-note"><h3>{t('Mi participación', 'My role')}</h3><p>{copy.role}</p><small>{t('Proyecto personal · Chilete DevPath', 'Personal project · Chilete DevPath')}</small></aside>
  </section>
  <ProjectMedia media={media} lang={lang} />
  <section id="funciones" class="pf-section">
    <span class="pf-kicker">02 / {t('SOLUCIÓN', 'SOLUTION')}</span><h2>{t('Qué permite hacer', 'What it enables')}</h2>
    <div class="pf-feature-grid">{copy.features.map(([title, text], index) => <article><span class="pf-kicker">0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
  </section>
  <section id="decisiones" class="pf-section">
    <span class="pf-kicker">03 / {t('DISEÑO DEL SISTEMA', 'SYSTEM DESIGN')}</span><h2>{t('Decisiones que sostienen la solución.', 'Decisions behind the solution.')}</h2>
    <figure class="pf-architecture"><ol>{project.architecture.map(node => <li>{node}</li>)}</ol><figcaption>{t('Esquema simplificado de componentes; no representa una captura de la aplicación.', 'Simplified component diagram; this is not an application screenshot.')}</figcaption></figure>
    <div class="pf-decision-list">{copy.decisions.map(([title, text], index) => <article><span>0{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
  </section>
  <section id="resultado" class="pf-section pf-two-columns">
    <div><span class="pf-kicker">04 / {t('RESULTADO', 'OUTCOME')}</span><h2>{t('Qué resolví con este proyecto.', 'What I solved with this project.')}</h2></div>
    <ul class="pf-outcomes">{copy.outcomes.map(outcome => <li>{outcome}</li>)}</ul>
  </section>
  <section id="evidencia" class="pf-section pf-two-columns">
    <div><span class="pf-kicker">05 / {t('VALIDACIÓN', 'VALIDATION')}</span><h2>{t('Cómo respaldo el trabajo.', 'How I support the work.')}</h2><p>{copy.evidence}</p></div>
    <aside class="pf-note">
      <h3>{t('Alcance de la versión presentada', 'Scope of the version presented')}</h3><p>{copy.limits}</p>
      <div class="pf-scope-block"><details><summary>{t('Evolución del proyecto', 'Project evolution')}</summary><p>{copy.next}</p></details></div>
      <small>{t('Ficha revisada el 15/10/2026 · estado basado en la documentación del proyecto', 'Case reviewed October 15, 2026 · status based on project documentation')}</small>
    </aside>
    <ProjectSupport items={media.supporting} lang={lang} />
  </section>
  <footer class="pf-case-footer"><h2>{t('¿Te interesa cómo lo construí?', 'Interested in how I built it?')}</h2><a class="pf-button" href={`${root}/#contacto`}>{t('Contactar', 'Get in touch')} ↗</a><a class="pf-back" href={`${root}/#trabajo`}>← {t('Explorar los otros proyectos', 'Explore the other projects')}</a></footer>
</article>
