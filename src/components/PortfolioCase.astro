---

const { project, lang = 'es' } = Astro.props;
const en = lang === 'en';
const t = (es, english) => en ? english : es;
const copy = project[lang];
const root = `${en ? '/en' : ''}`;
---
<article class="pf-shell pf-detail">
  <a class="pf-back" href={`${root}/`}>← {t('Volver al portafolio', 'Back to portfolio')}</a>
  <header class:list={['pf-case-hero', `pf-${project.accent}`]}><div><span class="pf-kicker">/{project.number} · {copy.category}</span><h1>{project.name}</h1><p>{copy.summary}</p><span class="pf-status">{copy.status}</span><div class="pf-actions"><a class="pf-button" href={project.url} target="_blank" rel="noopener noreferrer">{t('Visitar sitio', 'Visit website')} ↗</a>{project.repository && <a class="pf-button pf-secondary" href={project.repository} target="_blank" rel="noopener noreferrer">{t('Repositorio', 'Repository')} ↗</a>}<a class="pf-button pf-secondary" href={`${root}/#contacto`}>{t('Conversar sobre el proyecto', 'Discuss the project')}</a></div></div><img src={project.mark} width="170" height="170" alt={t(`Identidad de ${project.name}`, `${project.name} identity`)} /></header>
  <ul class="pf-tags pf-case-tags" aria-label={t('Tecnologías', 'Technologies')}>{project.stack.map(tech => <li>{tech}</li>)}</ul>
  <nav class="pf-case-nav" aria-label={t('Contenido del caso', 'Case contents')}><a href="#problema">{t('Problema', 'Problem')}</a><a href="#funciones">{t('Solución', 'Solution')}</a><a href="#decisiones">{t('Arquitectura', 'Architecture')}</a><a href="#evidencia">{t('Evidencia', 'Evidence')}</a></nav>
  <section id="problema" class="pf-section pf-two-columns"><div><span class="pf-kicker">01 / {t('CONTEXTO', 'CONTEXT')}</span><h2>{t('El problema', 'The problem')}</h2><p>{copy.problem}</p></div><aside class="pf-note"><h3>{t('Mi participación', 'My role')}</h3><p>{copy.role}</p><small>{t('Proyecto personal · Chilete DevPath', 'Personal project · Chilete DevPath')}</small></aside></section>
  <section id="funciones" class="pf-section"><span class="pf-kicker">02 / {t('SOLUCIÓN', 'SOLUTION')}</span><h2>{t('Qué permite hacer', 'What it enables')}</h2><div class="pf-feature-grid">{copy.features.map(([title, text], index) => <article><span class="pf-kicker">0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
  <section id="decisiones" class="pf-section"><span class="pf-kicker">03 / {t('DISEÑO DEL SISTEMA', 'SYSTEM DESIGN')}</span><h2>{t('Decisiones que sostienen la solución.', 'Decisions behind the solution.')}</h2><figure class="pf-architecture"><ol>{project.architecture.map(node => <li>{node}</li>)}</ol><figcaption>{t('Esquema simplificado de componentes; no representa una captura de la aplicación.', 'Simplified component diagram; this is not an application screenshot.')}</figcaption></figure><div class="pf-decision-list">{copy.decisions.map(([title, text], index) => <article><span>0{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>
  <section id="evidencia" class="pf-section pf-two-columns"><div><span class="pf-kicker">04 / {t('VALIDACIÓN', 'VALIDATION')}</span><h2>{t('Evidencia y estado real.', 'Evidence and actual status.')}</h2><p>{copy.evidence}</p><h3>{t('Próximos pasos', 'Next steps')}</h3><p>{copy.next}</p></div><aside class="pf-note"><h3>{t('Alcance y límites', 'Scope and limits')}</h3><p>{copy.limits}</p><small>{t('Ficha basada en la documentación local del proyecto · 13/10/2026', 'Case based on local project documentation · October 13, 2026')}</small></aside></section>
  <footer class="pf-case-footer"><h2>{t('¿Te interesa cómo lo construí?', 'Interested in how I built it?')}</h2><a class="pf-button" href={`${root}/#contacto`}>{t('Contactar', 'Get in touch')} ↗</a><a class="pf-back" href={`${root}/#trabajo`}>← {t('Explorar los otros proyectos', 'Explore the other projects')}</a></footer>
</article>
