---
import PortfolioHero from "./PortfolioHero.astro";
import PortfolioProfile from "./PortfolioProfile.astro";
import PortfolioResume from "./PortfolioResume.astro";
import PortfolioProjects from "./PortfolioProjects.astro";
import PortfolioContact from "./PortfolioContact.astro";
import SystemExplorer from "./SystemExplorer.astro";

const { lang = "es" } = Astro.props;
const en = lang === "en";
const t = (es, english) => (en ? english : es);
---

<div class="pf-shell">
  <nav
    class="pf-subnav"
    aria-label={t("Secciones del portafolio", "Portfolio sections")}
  >
    <a href="#trabajo">{t("Proyectos", "Projects")}</a>
    <a href="#enfoque">{t("Enfoque", "Approach")}</a>
    <a href="#perfil">{t("Perfil", "Profile")}</a>
    <a href="#cv">CV</a>
    <a href="#contacto">{t("Contacto", "Contact")}</a>
  </nav>
  <PortfolioHero lang={lang} />
  <PortfolioProjects lang={lang} />
  <SystemExplorer lang={lang} />
  <PortfolioProfile lang={lang} />
  <PortfolioResume lang={lang} />
  <PortfolioContact lang={lang} />
</div>
