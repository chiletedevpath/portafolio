---
import '../styles/global.css';
import '../styles/pages/portfolio.css';
import '../styles/technology.css';
import '../styles/contact.css';
import '../styles/structure.css';
import '../styles/media-motion.css';
import '../styles/welcome.css';
import WelcomeRoute from '../components/WelcomeRoute.astro';
const { title, description, hasContactForm = false } = Astro.props;
const en = Astro.url.pathname.startsWith('/en');
const lang = en ? 'en' : 'es';
const path = Astro.url.pathname;
const esPath = path.replace(/^\/en/, '') || '/';
const enPath = `/en${esPath}`;
const site = 'https://portafolio.chiletedevpath.com';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><meta name="author" content="Adrián Pisco" />
  <link rel="canonical" href={`${site}${path}`} /><link rel="alternate" hreflang="es" href={`${site}${esPath}`} /><link rel="alternate" hreflang="en" href={`${site}${enPath}`} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={`${site}${path}`} /><meta property="og:type" content="website" /><meta property="og:image" content={`${site}/assets/img/og-image.jpg`} />
  <meta name="twitter:card" content="summary_large_image" /><link rel="icon" href="/assets/img/marca-simbolo-nav.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800&family=Geist+Mono:wght@600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') || 'dark'; } catch { document.documentElement.dataset.theme = 'dark'; }</script>
  {hasContactForm && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>
  <WelcomeRoute lang={lang} />
  <a class="skip-link" href="#contenido">{en ? 'Skip to content' : 'Saltar al contenido'}</a>
  <header class="portfolio-header"><nav aria-label={en ? 'Main navigation' : 'Navegación principal'}><a class="portfolio-brand" href={en ? '/en/' : '/'}>Adrián Pisco<span> / {en ? 'Portfolio' : 'Portafolio'}</span></a><div><a href={en ? esPath : enPath} lang={en ? 'es' : 'en'}>{en ? 'ES' : 'EN'}</a><button type="button" data-theme-toggle aria-label={en ? 'Change color theme' : 'Cambiar tema'}>◐</button><a href="https://chiletedevpath.com" target="_blank" rel="noopener noreferrer">Chilete DevPath ↗</a></div></nav></header>
  <main id="contenido"><slot /></main>
  <footer class="portfolio-footer"><strong>Adrián Pisco</strong><p>{en ? 'Software development · Peru' : 'Desarrollo de software · Perú'}</p><a href="https://chiletedevpath.com">Chilete DevPath ↗</a><button type="button" class="replay-intro" data-replay-intro>{en ? 'Replay welcome' : 'Repetir bienvenida'} ↗</button><small>© {new Date().getFullYear()} Adrián Pisco</small></footer>
  <script>import '../scripts/portfolio.js';</script>
</body>
</html>
